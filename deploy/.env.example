# Lives on the server as ~/apps/boardgames/.env (never in git).
# Generate each value with: openssl rand -hex 32

POSTGRES_PASSWORD=
JWT_SECRET=

# The administrator who can sign in at /admin. Set both or neither; the password needs 12+
# characters. Changing ADMIN_PASSWORD and redeploying signs every administrator session out.
ADMIN_USERNAME=
ADMIN_PASSWORD=
