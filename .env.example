# Copy to apps/api/.env

PORT=3000
JWT_SECRET=change-me

# Pause before each action a computer player takes, in milliseconds.
BOT_ACTION_DELAY_MS=700

# The administrator who can sign in at /admin. Set both (password: 12+ characters) or neither;
# with neither there is no administrator and the admin area is off. The account is created, or
# its password updated, when the API starts.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# How many reverse proxies sit in front of the API (0 when run directly), so sign-in throttling
# sees the caller's address rather than the proxy's.
TRUST_PROXY=0

# Leave DATABASE_URL empty to run on embedded Postgres (PGlite) stored in PGLITE_DATA_DIR.
# With `docker compose up -d`: postgres://bgp:bgp@localhost:5432/bgp
DATABASE_URL=
PGLITE_DATA_DIR=.data/pglite
